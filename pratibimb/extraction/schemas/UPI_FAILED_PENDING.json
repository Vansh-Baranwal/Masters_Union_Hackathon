{
  "type": "object",
  "description": "UPI payment failed, pending, or processing screenshot",
  "properties": {
    "amount":               { "type": "number",  "description": "Amount attempted in INR" },
    "currency":             { "type": "string",  "description": "Currency code, default INR" },
    "timestamp":            { "type": "string",  "description": "Transaction attempt date and time" },
    "utr":                  { "type": "string",  "description": "UTR or reference number if assigned despite failure" },
    "order_id":             { "type": "string",  "description": "Order or transaction ID if shown" },
    "payer_name_masked":    { "type": "string",  "description": "Partial / masked sender name" },
    "payee_name":           { "type": "string",  "description": "Intended recipient name" },
    "status_text":          { "type": "string",  "description": "Exact status label, e.g. 'Payment Failed', 'Transaction Pending'" },
    "failure_reason":       { "type": "string",  "description": "Reason text shown for failure if present" },
    "app_name":             { "type": "string",  "description": "Payment app name" },
    "bank_name":            { "type": "string",  "description": "Bank name if shown" },
    "language_detected":    { "type": "string",  "description": "BCP-47 language code" }
  },
  "required": []
}
