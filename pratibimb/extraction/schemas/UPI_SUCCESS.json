{
  "type": "object",
  "description": "UPI payment success screenshot from any payment app (GPay, PhonePe, Paytm, BHIM, etc.)",
  "properties": {
    "amount":               { "type": "number",  "description": "Amount paid in INR" },
    "currency":             { "type": "string",  "description": "Currency code, default INR" },
    "timestamp":            { "type": "string",  "description": "Transaction date and time (ISO 8601 preferred)" },
    "utr":                  { "type": "string",  "description": "UPI Transaction Reference / UTR number" },
    "order_id":             { "type": "string",  "description": "Merchant order or transaction ID if shown" },
    "payer_name_masked":    { "type": "string",  "description": "Partial / masked sender name or account" },
    "payee_name":           { "type": "string",  "description": "Merchant or recipient name" },
    "status_text":          { "type": "string",  "description": "Status label, e.g. 'Payment Successful', 'Money Sent'" },
    "app_name":             { "type": "string",  "description": "Payment app name, e.g. 'Google Pay', 'PhonePe'" },
    "bank_name":            { "type": "string",  "description": "Bank associated with the payer account if shown" },
    "language_detected":    { "type": "string",  "description": "BCP-47 language code" }
  },
  "required": []
}
