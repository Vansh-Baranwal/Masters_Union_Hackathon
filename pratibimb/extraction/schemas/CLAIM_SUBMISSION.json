{
  "type": "object",
  "description": "Reimbursement claim or expense submission screenshot",
  "properties": {
    "amount":               { "type": "number",  "description": "Claimed amount in INR" },
    "currency":             { "type": "string",  "description": "Currency code, default INR" },
    "timestamp":            { "type": "string",  "description": "Journey or submission date" },
    "ticket_id":            { "type": "string",  "description": "Ticket reference being claimed" },
    "order_id":             { "type": "string",  "description": "Order ID on the claim form" },
    "origin_station":       { "type": "string",  "description": "Journey origin station" },
    "destination_station":  { "type": "string",  "description": "Journey destination station" },
    "payer_name_masked":    { "type": "string",  "description": "Employee or claimant name (partial)" },
    "status_text":          { "type": "string",  "description": "Claim status if shown" },
    "language_detected":    { "type": "string",  "description": "BCP-47 language code" }
  },
  "required": []
}
