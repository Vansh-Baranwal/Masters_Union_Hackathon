# ─── Sarvam AI ────────────────────────────────────────────────
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_BASE_URL=https://api.sarvam.ai

# ─── Telegram Bot ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ─── Twilio WhatsApp Sandbox (optional secondary channel) ─────
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ─── Database ─────────────────────────────────────────────────
# SQLite for demo; switch to postgresql+asyncpg://... for production
DATABASE_URL=sqlite+aiosqlite:///./pratibimb.db

# ─── Storage ──────────────────────────────────────────────────
RAW_IMAGE_DIR=./data/raw_images
# Encryption key for raw images at rest (Fernet, 32-byte base64)
IMAGE_ENCRYPTION_KEY=

# ─── Retention ────────────────────────────────────────────────
# Days after case closure before raw image is deleted
RAW_IMAGE_RETENTION_DAYS=30

# ─── App ──────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ─── Duplicate detection thresholds ──────────────────────────
# Hamming distance at or below this value → perceptual match signal
PHASH_SIMILARITY_THRESHOLD=8
AHASH_SIMILARITY_THRESHOLD=6

# ─── Linking engine ───────────────────────────────────────────
# Max seconds between payment and ticket timestamps to allow INFERRED link
INFERRED_LINK_TIME_TOLERANCE_SECONDS=600
# Min score to consider an INFERRED link (0.0–1.0)
INFERRED_LINK_MIN_SCORE=0.55

# ─── Case logic ───────────────────────────────────────────────
# Hours after payment_seen with no ticket_seen before case is opened
CASE_OPEN_HOURS=2
